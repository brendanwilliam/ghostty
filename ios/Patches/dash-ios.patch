 #include <unistd.h>
 #include <stdlib.h>
 #include <string.h>
@@ -314,6 +316,29 @@ onsig(int signo)
  * handlers while we are executing a trap handler.
  */
 
+/*
+ * Cooperative interrupt for iOS, where no signal reaches this thread.
+ * The host app calls dash_request_interrupt() with the thread running the
+ * shell; the shell, which polls here between commands, raises the same
+ * interrupt a ^C would. Each copy of dash (dash, dashA...) has its own
+ * target, so only the shell on that thread is interrupted.
+ */
+static volatile pthread_t ios_interrupt_target;
+static volatile sig_atomic_t ios_interrupt_set;
+static volatile time_t ios_interrupt_time;
+
+void dash_request_interrupt(pthread_t target)
+{
+	ios_interrupt_target = target;
+	ios_interrupt_time = time(NULL);
+	ios_interrupt_set = 1;
+}
+
+void dash_clear_interrupt(void)
+{
+	ios_interrupt_set = 0;
+}
+
 void dotrap(void)
 {
 	char *p;
@@ -321,6 +346,19 @@ void dotrap(void)
 	int i;
 	int status, last_status;
 
+	if (ios_interrupt_set) {
+		/*
+		 * Thread ids get reused, so a request that was aimed at
+		 * another shell and never consumed expires.
+		 */
+		if (time(NULL) - ios_interrupt_time > 2)
+			ios_interrupt_set = 0;
+		else if (pthread_equal(ios_interrupt_target, pthread_self())) {
+			ios_interrupt_set = 0;
+			onint();
+		}
+	}
+
 	if (!pending_sig)
 		return;
 
